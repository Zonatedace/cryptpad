# Public URLs users type in the browser. Production needs two hostnames
# (main + sandbox) for CryptPad's XSS isolation. Local compose can use
# http://localhost and leave the sandbox blank to use port 3001 instead.
CPAD_MAIN_DOMAIN=https://draw.brandonslab.work
CPAD_SANDBOX_DOMAIN=https://sandbox.draw.brandonslab.work

# Random 64-hex login salt. Generate once and keep it:
#   openssl rand -hex 32
# Changing this later breaks every existing account.
CPAD_LOGIN_SALT=replace-me-with-openssl-rand-hex-32
